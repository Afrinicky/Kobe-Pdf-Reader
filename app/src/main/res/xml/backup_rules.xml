<?xml version="1.0" encoding="utf-8"?>
<!--
  Back up the small library index (recents, favorites, reading positions) and
  settings. Never back up cached page bitmaps or working copies of documents -
  the documents themselves are the user's, not ours to copy anywhere.
-->
<full-backup-content>
    <include
        domain="database"
        path="kobe-reader.db" />
    <include
        domain="sharedpref"
        path="." />
    <include
        domain="file"
        path="datastore/" />
    <exclude
        domain="file"
        path="output/" />
    <exclude
        domain="external"
        path="." />
    <exclude
        domain="root"
        path="cache" />
</full-backup-content>
