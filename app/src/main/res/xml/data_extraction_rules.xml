<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="kobe-reader.db" />
        <include
            domain="file"
            path="datastore/" />
        <exclude
            domain="file"
            path="output/" />
        <exclude
            domain="root"
            path="cache" />
    </cloud-backup>
    <!-- Device-to-device transfer may carry the same small index, nothing else. -->
    <device-transfer>
        <include
            domain="database"
            path="kobe-reader.db" />
        <include
            domain="file"
            path="datastore/" />
    </device-transfer>
</data-extraction-rules>
